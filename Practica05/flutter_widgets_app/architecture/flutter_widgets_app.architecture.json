  "cards": [
    {
      "dot": "emerald",
      "title": "Persistencia y Estado",
      "items": [
        "SharedPreferences almacena selected_color_theme e is_dark_mode en disco.",
        "ThemeNotifier precarga las preferencias al arrancar y sincroniza cambios de tema y modo oscuro en tiempo real.",
        "CounterScreen y ThemeChangerScreen comparten el mismo estado global de modo oscuro mediante themeNotifierProvider."
      ]
    },
    {
      "dot": "violet",
      "title": "Cambio Dinámico de Ícono y Multi-Splash",
      "items": [
        "DynamicIconHelper invoca el canal nativo com.example.flutter_widgets_app/dynamic_icon.",
        "MainActivity.kt commuta atómicamente entre 8 activity-alias en onStop() para actualizar el lanzador sin cerrar la app.",
        "SplashScreen detecta el tema activo al iniciar y despliega el logotipo (logo.jpg a logo8.jpg), degradado aurora y nombre correspondiente."
      ]
    }
