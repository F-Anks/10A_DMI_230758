  "cards": [
    {
      "dot": "cyan",
      "title": "Inversión de Dependencias (DIP)",
      "items": [
        "El FeedProvider depende exclusivamente de la abstracción VideoPostRepository de Dominio",
        "La interfaz de usuario nunca conoce si los datos provienen de un archivo local o de endpoints HTTP"
      ]
    },
    {
      "dot": "emerald",
      "title": "Múltiples DataSources Desacoplados",
      "items": [
        "LocalVideoDatasource: Suministra videos estáticos embebidos para modo sin conexión o pruebas unitarias",
        "RapidApiDatasource: Orquesta las solicitudes de red hacia múltiples proveedores con políticas de reintento"
      ]
    },
    {
      "dot": "violet",
      "title": "Segmentación en 3 APIs Lógicas",
      "items": [
        "API 1 (TikWM US): Feed global de tendencias virales en la pestaña Para Ti",
        "API 2 (Pixabay): Videos de deportes y acción optimizados en resolución tiny para bajo consumo de memoria",
        "API 3 (Regional MX / Scraper): Contenido localizado con arquitectura de failover y proxy regional"
      ]
    },
    {
      "dot": "amber",
      "title": "Beneficios de Clean Architecture",
      "items": [
        "Facilidad de testing mediante Mocks inyectables en VideoPostsRepositoryImpl",
        "Escalabilidad inmediata para agregar nuevos orígenes de datos (ej. Firebase, GraphQL) sin modificar la UI"
      ]
    }
  ]
